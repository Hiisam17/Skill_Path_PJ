{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "moduleNameMapper": {
    "^jwks-rsa$": "<rootDir>/mocks/jwks-rsa.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
